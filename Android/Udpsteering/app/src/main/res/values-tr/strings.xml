    <!-- Setup guide screen -->
    <string name="guide_eyebrow">NASIL YAPILIR</string>
    <string name="guide_title">Kurulum Rehberi</string>
    <string name="guide_intro">Bu sayfa SENİN gerçek değerlerini gösterir. Oyuna aynen yazman yeterli — tahmin yok, ekran görüntüsünden kopya yok.</string>
    <string name="guide_ip_label">TELEFONUNUN IP ADRESİ</string>
    <string name="guide_ip_missing">— telefonu Wi-Fi\'a bağla, bu alan kendiliğinden dolacak —</string>
    <string name="guide_value_address">Adres (Address)</string>
    <string name="guide_value_port">Port</string>
    <string name="guide_value_rate">Güncelleme hızı</string>

    <string name="guide_connect_title">1 · BAĞLANTI — ZORUNLU</string>
    <string name="guide_connect_what">Direksiyon, gaz ve fren telefondan kontrol edilir.</string>
    <string name="guide_connect_s1">Telefon ve PC aynı Wi-Fi ağında olmalı</string>
    <string name="guide_connect_s2">Oyunda: Seçenekler → Kontroller → Donanım → Uzaktan Kumanda QR kodunu aç</string>
    <string name="guide_connect_s3">QR KODU TARA\'ya bas ve kamerayı koda tut — bu kadar</string>

    <string name="guide_dash_title">2 · CANLI GÖSTERGE — İSTEĞE BAĞLI</string>
    <string name="guide_dash_what">Sürüş ekranında açılır: canlı hız, devir ibresi, vites, yakıt, motor sıcaklığı, turbo basıncı, gerçek uyarı ışıkları (sinyaller, uzun far, el freni, ABS, TC, yağ, akü) ve kaza titreşimi.</string>
    <string name="guide_dash_s1">Oyunda: Seçenekler → Diğer → Protocols bölümüne in</string>
    <string name="guide_dash_s2">“Dış Gösterge desteği” kutusunu işaretle ve aşağıdaki değerleri gir</string>
    <string name="guide_dash_s3">Aracı bir kez yenile (Ctrl+R) — oyun bu ayarı araç yüklenirken okur</string>

    <string name="guide_drift_title">3 · DRIFT METRE — İSTEĞE BAĞLI</string>
    <string name="guide_drift_what">Savrulurken hız göstergesinin üstünde canlı drift açısı ve seans rekorunu gösterir. 0-100 kronometresiyle (uygulama Ayarları\'ndan aç) çok yakışır.</string>
    <string name="guide_drift_s1">Oyunda: Seçenekler → Diğer → Protocols (aynı yer)</string>
    <string name="guide_drift_s2">“MotionSim etkinleştirildi” kutusunu işaretle ve aşağıdaki değerleri gir</string>
    <string name="guide_drift_s3">Aracı bir kez yenile (Ctrl+R)</string>

    <string name="guide_trouble_title">SORUN GİDERME</string>
    <string name="guide_trouble_1">Hiçbir şey gelmiyor mu? Windows Güvenlik Duvarı\'nda BeamNG.drive\'a izin ver.</string>
    <string name="guide_trouble_2">Misafir/otel Wi-Fi ağları telefonla PC\'nin konuşmasını çoğu zaman engeller — kendi ağını ya da telefonun hotspot\'unu kullan.</string>
    <string name="guide_trouble_3">Modem telefona yeni IP mi verdi? Bu sayfayı yeniden kontrol et, oyundaki değeri güncelle, sonra Ctrl+R.</string>
    <string name="guide_trouble_4">Oyun güncellemesinden sonra göstergeler dondu mu? Kutuları yeniden işaretle — ayarlar bazen sıfırlanır.</string>

