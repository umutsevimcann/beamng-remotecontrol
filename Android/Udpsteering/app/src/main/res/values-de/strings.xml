    <!-- Setup guide screen -->
    <string name="guide_eyebrow">ANLEITUNG</string>
    <string name="guide_title">Einrichtung</string>
    <string name="guide_intro">Diese Seite zeigt DEINE echten Werte. Einfach exakt so ins Spiel eintragen — kein Raten, kein Abschreiben von Screenshots.</string>
    <string name="guide_ip_label">IP-ADRESSE DEINES HANDYS</string>
    <string name="guide_ip_missing">— Handy mit dem WLAN verbinden, dann füllt sich dieses Feld —</string>
    <string name="guide_value_address">Adresse (Address)</string>
    <string name="guide_value_port">Port</string>
    <string name="guide_value_rate">Aktualisierungsrate</string>

    <string name="guide_connect_title">1 · VERBINDEN — ERFORDERLICH</string>
    <string name="guide_connect_what">Lenken, Gas geben und bremsen direkt vom Handy.</string>
    <string name="guide_connect_s1">Handy und PC müssen im selben WLAN sein</string>
    <string name="guide_connect_s2">Im Spiel: Options → Controls → Hardware → Remote-Control-QR anzeigen</string>
    <string name="guide_connect_s3">QR-CODE SCANNEN antippen und die Kamera auf den Code richten — fertig</string>

    <string name="guide_dash_title">2 · LIVE-COCKPIT — OPTIONAL</string>
    <string name="guide_dash_what">Schaltet auf dem Fahrbildschirm frei: Tempo, Drehzahlnadel, Gang, Tank, Motortemperatur, Ladedruck, echte Warnleuchten (Blinker, Fernlicht, Handbremse, ABS, TC, Öl, Batterie) und Crash-Vibration.</string>
    <string name="guide_dash_s1">Im Spiel: Options → Other → zum Abschnitt Protocols scrollen</string>
    <string name="guide_dash_s2">„OutGauge support“ anhaken und die Werte unten eintragen</string>
    <string name="guide_dash_s3">Fahrzeug einmal neu laden (Strg+R) — das Spiel liest die Einstellung beim Spawnen</string>

    <string name="guide_drift_title">3 · DRIFT-ANZEIGE — OPTIONAL</string>
    <string name="guide_drift_what">Zeigt beim Driften den Live-Winkel über dem Tacho plus deinen Sitzungsrekord. Passt perfekt zum 0-100-Timer (in den App-Einstellungen aktivieren).</string>
    <string name="guide_drift_s1">Im Spiel: Options → Other → Protocols (gleiche Stelle)</string>
    <string name="guide_drift_s2">„MotionSim enabled“ anhaken und die Werte unten eintragen</string>
    <string name="guide_drift_s3">Fahrzeug einmal neu laden (Strg+R)</string>

    <string name="guide_trouble_title">FEHLERSUCHE</string>
    <string name="guide_trouble_1">Es kommt nichts an? BeamNG.drive in der Windows-Firewall zulassen.</string>
    <string name="guide_trouble_2">Gäste-/Hotel-WLAN blockiert oft die Verbindung zwischen Handy und PC — eigenes Netz oder Handy-Hotspot verwenden.</string>
    <string name="guide_trouble_3">Router hat dem Handy eine neue IP gegeben? Diese Seite prüfen, den Wert im Spiel aktualisieren, dann Strg+R.</string>
    <string name="guide_trouble_4">Anzeigen nach einem Spiel-Update eingefroren? Häkchen neu setzen — Einstellungen werden gelegentlich zurückgesetzt.</string>

