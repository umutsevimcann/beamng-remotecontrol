<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".MainActivity">

    <!-- ===== CENTER HUD ===== -->
    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_status_panel"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Speed -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom">

            <TextView
                android:id="@+id/Textspeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="000"
                android:textSize="64sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-condensed"/>

            <TextView
                android:id="@+id/Textunit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km/h"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Gear -->
        <TextView
            android:id="@+id/Textgear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="N"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="@color/beamng_orange"
            android:background="@drawable/bg_gear_badge"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"/>
    </LinearLayout>

    <!-- Connection Status -->
    <TextView
        android:id="@+id/Textdelay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/infoPanel"
        android:layout_centerHorizontal="true"
        android:text="Connecting..."
        android:textColor="@color/status_disconnected"
        android:textSize="11sp"
        android:layout_marginTop="4dp"/>

    <!-- ===== CONTROLS AREA ===== -->

    <!-- LEFT: BRAKE (touch zone with fill indicator) -->
    <FrameLayout
        android:id="@+id/breakcontrol"
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/btn_brake"/>

        <!-- Fill overlay - grows from bottom based on pressure -->
        <View
            android:id="@+id/brakeFill"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:background="@color/brake_fill"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="BRAKE"
            android:textColor="#66FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"/>
    </FrameLayout>

    <!-- RIGHT: GAS (touch zone with fill indicator) -->
    <FrameLayout
        android:id="@+id/throttlecontrol"
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/btn_gas"/>

        <!-- Fill overlay - grows from bottom based on pressure -->
        <View
            android:id="@+id/throttleFill"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:background="@color/gas_fill"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="GAS"
            android:textColor="#66FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"/>
    </FrameLayout>

    <!-- CENTER: Steering Buttons -->
    <LinearLayout
        android:id="@+id/buttonControlsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnSteerLeft"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/btn_steer"
            android:text="◀"
            android:textSize="28sp"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="24dp"/>

        <Button
            android:id="@+id/btnSteerRight"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/btn_steer"
            android:text="▶"
            android:textSize="28sp"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

    <!-- CENTER: Steering Slider -->
    <SeekBar
        android:id="@+id/steeringSlider"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:max="100"
        android:progress="50"
        android:thumbTint="@color/beamng_orange"
        android:progressTint="@color/text_secondary"
        android:progressBackgroundTint="@color/surface_elevated"
        android:visibility="gone"/>

    <!-- Settings Button (top-right, subtle) -->
    <ImageButton
        android:id="@+id/menuButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="12dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_preferences"
        android:tint="@color/text_dim"
        android:contentDescription="Settings"/>

    <!-- ===== DASHBOARD LIGHTS (bottom center, subtle) ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <!-- No headlight icon: the game's OutGauge stream carries no low-beam bit. -->
        <ImageView android:id="@+id/light_fullbeam" android:layout_width="20dp" android:layout_height="20dp" android:visibility="invisible" android:layout_margin="6dp" android:tint="#4488FF" android:src="@android:drawable/presence_online"/>
        <ImageView android:id="@+id/light_break" android:layout_width="20dp" android:layout_height="20dp" android:visibility="invisible" android:layout_margin="6dp" android:tint="#FF3333" android:src="@android:drawable/presence_online"/>
        <ImageView android:id="@+id/light_leftindicator" android:layout_width="20dp" android:layout_height="20dp" android:visibility="invisible" android:layout_margin="6dp" android:tint="@color/beamng_orange" android:src="@android:drawable/presence_online"/>
        <ImageView android:id="@+id/light_rightindicator" android:layout_width="20dp" android:layout_height="20dp" android:visibility="invisible" android:layout_margin="6dp" android:tint="@color/beamng_orange" android:src="@android:drawable/presence_online"/>
        <ImageView android:id="@+id/light_abs" android:layout_width="20dp" android:layout_height="20dp" android:visibility="invisible" android:layout_margin="6dp" android:tint="#FFAA00" android:src="@android:drawable/presence_online"/>
    </LinearLayout>

</RelativeLayout>
